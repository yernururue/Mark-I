    {
      "id": "phase-gates-label",
      "type": "text",
      "x": 120,
      "y": 430,
      "width": 600,
      "height": 220,
      "text": "STRICT PHASE GATES\n\n1.0: clean Python 3.11 resolution and defect matrix\n1.1: lazy settings; zero Pydantic env warnings\n1.2: all routers import; OpenAPI builds with overrides\n1.3: workers import from /app with no client construction\n1.4: supported ADK adapter; structured output tests\n1.5: real Firestore filters/transactions; faithful fakes\n1.6: TestClient + Docker health and worker smoke",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
